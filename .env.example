# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://mindmesh.co.ke

# Contact details shown on the site. Confirm these before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@mindmesh.co.ke
# WhatsApp number in international format, digits only (e.g. 2547XXXXXXXX). WhatsApp buttons are hidden when unset.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public URL of the Schoolary platform. The "Visit Schoolary" button is hidden when unset.
NEXT_PUBLIC_SCHOOLARY_URL=

# Server-side only: where enquiries from /contact are delivered (Formspree, Zapier, Make, n8n or any endpoint that accepts JSON).
CONTACT_WEBHOOK_URL=
